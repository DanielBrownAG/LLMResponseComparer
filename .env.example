# LLM Response Comparer - Environment Configuration

# Server
PORT=3001
NODE_ENV=development

# OpenAI Configuration
# Set this to enable direct OpenAI models; leave empty for Azure-only use.
OPENAI_API_KEY=
OPENAI_MODELS=gpt-6-astra,gpt-6-sol,gpt-6-luna

# Azure OpenAI Configuration - Model 1
MODEL_1_NAME=Azure GPT-4.1
MODEL_1_ENDPOINT=
MODEL_1_API_KEY=
MODEL_1_DEPLOYMENT_ID=
MODEL_1_MODEL=gpt-4.1
MODEL_1_API_VERSION=2025-01-01-preview

# Azure OpenAI Configuration - Model 2
MODEL_2_NAME=Azure GPT-6
MODEL_2_ENDPOINT=
MODEL_2_API_KEY=
MODEL_2_DEPLOYMENT_ID=
MODEL_2_MODEL=gpt-6-astra
MODEL_2_API_VERSION=2025-01-01-preview
